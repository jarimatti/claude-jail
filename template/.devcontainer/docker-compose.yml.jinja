# Explicit project name (letters and digits only, derived from project_name) so VS Code, the devcontainers
# CLI and `podman compose` (see justfile) all address the same containers
name: claudejail{{ project_name | lower | replace(' ', '') | replace('.', '') | replace('-', '') | replace('_', '') }}

# The jail is on an --internal network with no route out; the only way out is the squid proxy,
# which is attached to both networks and tunnels HTTPS to hosts in proxy/allowed-domains.txt.
# userns_mode can't be combined with podman-compose's default shared pod
x-podman:
  in_pod: false

services:
  proxy:
    image: docker.io/ubuntu/squid:latest
    restart: unless-stopped
    volumes:
      - ./proxy/squid.conf:/etc/squid/squid.conf:ro
      - ./proxy/allowed-domains.txt:/etc/squid/allowed-domains.txt:ro
    networks: [jail, egress]

  jail:
    image: mcr.microsoft.com/devcontainers/base:trixie
    user: vscode
    # Rootless Podman maps the host user to root in the container; map it to vscode (uid 1000) instead
    # so /workspace is writable and not root-owned
    userns_mode: "keep-id:uid=1000,gid=1000"
    command: sleep infinity
    cap_drop: [ALL]
    security_opt: ["no-new-privileges"]
    depends_on: [proxy]
    volumes:
      - ..:/workspace
      # The proxy config lives here; the jail must not be able to widen its own allowlist
      - .:/workspace/.devcontainer:ro
      # Hooks run on the host at the next git command, so they are read-only too (needs a git repo)
      - ../.git/hooks:/workspace/.git/hooks:ro
      - claude-config:/home/vscode/.claude:U
    networks: [jail]

networks:
  jail:
    internal: true
  egress:

volumes:
  claude-config:
