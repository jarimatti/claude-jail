# Claude Jail helpers. `just` with no arguments lists them.
# Name the compose project after the directory (overrides `name:` in the compose file), so clones of
# the same repo in different directories get separate containers. Letters and digits only, because the
# devcontainers CLI strips everything else. With the default project_name this equals the compose `name:`.
project := "claudejail" + replace_regex(lowercase(file_name(justfile_directory())), "[^a-z0-9]", "")
export COMPOSE_PROJECT_NAME := project

dc := "npx @devcontainers/cli"
podman := "--docker-path podman --docker-compose-path podman-compose --workspace-folder ."
# Absolute path: podman-compose fails to find a relative -f file
# -p is needed because podman-compose prefers `name:` from the file over COMPOSE_PROJECT_NAME
compose := "podman compose -p " + project + " -f " + justfile_directory() + "/.devcontainer/docker-compose.yml"

[private]
default:
    @just --list

# Start the proxy and the jail (first run pulls images and installs Claude Code)
up:
    {{dc}} up {{podman}}

# Open a shell in the jail
shell:
    {{dc}} exec {{podman}} bash

# Run Claude Code in the jail (log in on first run)
claude *args:
    {{dc}} exec {{podman}} claude {{args}}

# Stop the proxy and the jail; the login volume is kept
down:
    {{compose}} down

# Stop and delete everything, including the login volume
destroy:
    {{compose}} down -v

# Restart the proxy after editing .devcontainer/proxy/allowed-domains.txt
restart-proxy:
    {{compose}} restart proxy

# Show proxy logs (denied requests appear here)
logs:
    {{compose}} logs proxy
