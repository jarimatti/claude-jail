{
  "name": "Claude Jail (Podman)",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "initializeCommand": "bash .devcontainer/proxy/up.sh",
  "runArgs": [
    "--network=claude-jail-net",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges"
  ],
  "updateRemoteUserUID": false,
  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "HTTPS_PROXY": "http://claude-jail-proxy:3128",
    "HTTP_PROXY": "http://claude-jail-proxy:3128",
    "NO_PROXY": "localhost,127.0.0.1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "mounts": [
    "source=claude-jail-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "workspaceMount": "source=${localWorkspaceFolder}/workspace,target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
